# Joy9 Park — full standalone WordPress application repository
#
# Strategy: track the entire application (WordPress core, all plugins,
# all themes, docs, and the static html/ reference) as one deployable
# unit. Only environment-specific, generated, or local-tooling files
# are ignored below.

# Environment-specific configuration
wp-config.php

# Database dumps / backups
/db/
*.sql
*.sql.gz
*.sql.zip

# User-uploaded media
/wp-content/uploads/

# Core auto-upgrade staging area
/wp-content/upgrade/

# Cache directories (any plugin/object cache under wp-content)
/wp-content/cache/
/wp-content/*-cache/

# Debug log
/wp-content/debug.log

# WordPress maintenance-mode flag
/.maintenance

# Root .htaccess — environment-specific RewriteBase, not tracked for now
/.htaccess

# Dependency directories
node_modules/
vendor/

# Log files
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE-specific local files
/.vscode/
/.idea/
*.sublime-project
*.sublime-workspace

# Plugins that ship their composer deps must keep them (vendor/ above is for local tooling only)
!/wp-content/plugins/secure-custom-fields/vendor/
